{"kind":"table","sheet":"Sentence Bank","address":"A1:R29","rows":29,"cols":18,"values":[[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Celan sentence assets",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Canonical examples selected for the first learning units. Teaching status is separate from source approval.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Canonical sentences",20,"Approved source rows",20,"Draft exercises",30,"Learning objectives",13,null,null,null,null,null,null,null,null,null,null],["Scope","Starter assets for action-first syntax, commands, tense, aspect, questions, negation, address, practical repair, and a first conditional.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Asset ID","Unit","Stage","Learning focus","Celan","English","Sentence type","Signpost or marker","Verb","Subject","Object or complement","Extra context","Structure","Rule IDs","Source example ID","Source review","Teaching status","Teaching note"],["SEN-001","U01 Action First",1,"Basic action-first sentence","Var I dren.","I go to the water.","Statement",null,"Var","I","dren",null,"Verb–Subject–Destination","GR-V1-0004; GR-V1-0014","PE-V1-0017","Approved","Draft","Baseline sentence for recognizing and arranging VSO order."],["SEN-002","U01 Action First",1,"Basic command","Va var dren!","Go to the water!","Command","Va","var","Understood Ya","dren",null,"Va–Verb–Destination","GR-V1-0016","PE-V1-0027","Approved","Draft","The subject is understood rather than spoken."],["SEN-003","U01 Action First",2,"Verb, subject, and object","Velaen Ilin morlak.","We eat the bread.","Statement",null,"Velaen","Ilin","morlak",null,"Verb–Subject–Object","GR-V1-0004","PE-V4-0058","Approved","Draft","Adds a clear object and inclusive first-person plural subject."],["SEN-004","U02 Time and Aspect",2,"Past tense","Tha-var I dren.","I went to the water.","Statement","Tha-","var","I","dren",null,"Past–Verb–Subject–Destination","GR-V1-0014","PE-V1-0018","Approved","Draft","Past tense attaches to the verb."],["SEN-005","U02 Time and Aspect",2,"Future tense","Nor-var I dren.","I will go to the water.","Statement","Nor-","var","I","dren",null,"Future–Verb–Subject–Destination","GR-V1-0014","PE-V1-0019","Approved","Draft","Future tense attaches to the verb."],["SEN-006","U02 Time and Aspect",2,"Continuous aspect","Varal I dren.","I am going to the water.","Statement","-al","Var","I","dren",null,"Verb+Continuous–Subject–Destination","GR-V1-0014","PE-V1-0020","Approved","Draft","Continuous aspect follows the verb as a suffix."],["SEN-007","U02 Time and Aspect",2,"Perfective aspect","Varath I dren.","I have gone to the water.","Statement","-ath","Var","I","dren",null,"Verb+Perfective–Subject–Destination","GR-V1-0014","PE-V1-0021","Approved","Draft","Perfective aspect presents the action as completed."],["SEN-008","U02 Time and Aspect",2,"Habitual aspect","Varas I dren.","I usually go to the water.","Statement","-as","Var","I","dren",null,"Verb+Habitual–Subject–Destination","GR-V1-0014","PE-V1-0022","Approved","Draft","Habitual aspect marks a usual or repeated action."],["SEN-009","U03 Questions and Negation",2,"Verb negation","Ver var I dren.","I do not go to the water.","Negative statement","Ver","var","I","dren",null,"Ver–Verb–Subject–Destination","GR-V1-0015","PE-V1-0023","Approved","Draft","Ver sits directly before the verb."],["SEN-010","U03 Questions and Negation",2,"Direct question","Ra var Ya dren?","Do you go to the water?","Question","Ra","var","Ya","dren",null,"Ra–Verb–Subject–Destination","GR-V1-0005; GR-V1-0016","PE-V3-0018","Approved","Draft","Ra frames the sentence as a question."],["SEN-011","U03 Questions and Negation",3,"Future question with location","Nor-var Ya dren an Varthas?","Will you go to the water in the city?","Question","Nor-","var","Ya","dren","an Varthas","Future–Verb–Subject–Destination–Location","GR-V1-0014; GR-V1-0019","PE-V3-0019","Approved","Draft","Combines future time with an explicit spatial setting."],["SEN-012","U04 Address and Context",2,"Casual address","Var I dren, Ser.","I go to the water, friend.","Statement with address",null,"Var","I","dren","Ser","Verb–Subject–Destination–Address","GR-V3-0001","PE-V3-0001","Approved","Draft","Plain role address creates a casual or familiar tone."],["SEN-013","U04 Address and Context",2,"Respectful address","Var I dren, Li-Ser.","I go to the water, respected friend.","Statement with address","Li-","Var","I","dren","Li-Ser","Verb–Subject–Destination–Respectful Address","GR-V3-0001","PE-V3-0002","Approved","Draft","Li- marks respect on the form of address."],["SEN-014","U04 Address and Context",3,"Respectful command","Li-Ya, va var dren.","Respected one, please go to the water.","Command","Va; Li-","var","Understood Ya","dren","Li-Ya","Respectful Address–Va–Verb–Destination","GR-V1-0016; GR-V3-0001","PE-V3-0007","Approved","Draft","Combines direct command structure with respectful address."],["SEN-015","U04 Address and Context",3,"Time setting","Var I dren an Kinnshal.","I go to the water at dawn.","Statement",null,"Var","I","dren","an Kinnshal","Verb–Subject–Destination–Time Setting","GR-V1-0004","PE-V2-0001","Approved","Draft","Adds a time-of-day setting to the baseline movement sentence."],["SEN-016","U04 Address and Context",3,"Action with object and time","Tal I dren an Kinnlin.","I drink the water at noon.","Statement",null,"Tal","I","dren","an Kinnlin","Verb–Subject–Object–Time Setting","GR-V1-0004","PE-V2-0003","Approved","Draft","A second action pattern prevents overlearning only Var sentences."],["SEN-017","U05 Practical Speech",3,"Report lack of understanding","ver nemaen I.","I do not understand.","Negative statement","ver","nemaen","I",null,null,"Ver–Verb–Subject","GR-V1-0015","PE-UHEI1-0004","Approved","Draft","Useful conversational repair sentence."],["SEN-018","U05 Practical Speech",3,"Request clarification","va selnemaen Ya kel.","Clarify what was said.","Command","va","selnemaen","Ya","kel",null,"Va–Verb–Subject–Object","GR-V1-0016","PE-UHEI1-0011","Approved","Draft","Useful command for removing ambiguity from what was said."],["SEN-019","U05 Practical Speech",3,"Enter a place","va anshanaen Ya xaror.","Come inside the room.","Command","va","anshanaen","Ya","xaror",null,"Va–Verb–Subject–Destination","GR-V1-0016; ED-0030","PE-SRD1-0017","Approved","Draft","Practical command using an approved boundary-crossing verb."],["SEN-020","U06 Conditions",4,"Condition and result","Rath Ya var dren, Nor-var I shena.","If you go to the water, I will bring coinage.","Conditional","Rath; Nor-","var; var","Ya; I","dren; shena",null,"Rath–Clause, Future Main Clause","GR-V3-0005","PE-V3-0028","Approved","Draft","First multi-clause asset in the starter pack."]]}
